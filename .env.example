NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
APP_ENV=development
APP_URL=http://localhost:3000
PATIENT_PORTAL_URL=http://localhost:3000/portal
APP_VERSION=local
CRON_SECRET=replace-with-a-long-random-server-only-secret
ALLOW_DEMO_SEED=false

# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only Twilio configuration. Never expose these with NEXT_PUBLIC_.
COMMUNICATIONS_MODE=development
COMMUNICATIONS_ALLOW_LIVE_SEND=false
TELEPHONY_ALLOW_LIVE_CALLS=false
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_MESSAGING_SERVICE_SID=your-messaging-service-sid
TWILIO_DEFAULT_FROM_NUMBER=+13055550100
TWILIO_WEBHOOK_BASE_URL=https://your-public-dev-or-production-url.example.com

# Server-only Stripe/payment configuration. Use Stripe test mode for development.
PAYMENTS_MODE=development
PAYMENTS_ALLOW_LIVE_CHARGES=false
STRIPE_SECRET_KEY=sk_test_your_test_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_test_webhook_secret
STRIPE_CONNECT_ACCOUNT_ID=

# Server-only patient portal and recurring billing configuration.
PORTAL_MODE=development
PORTAL_SUPPORT_EMAIL=support@avora-demo.com
PORTAL_SUPPORT_PHONE=+13055550100
PORTAL_ALLOW_SIMULATED_PAYMENTS=true
STRIPE_CUSTOMER_PORTAL_RETURN_URL=http://localhost:3000/portal/payments
STRIPE_PORTAL_CONFIGURATION_ID=

# Server-only accounting integration configuration. Never expose these with NEXT_PUBLIC_.
ACCOUNTING_MODE=development
ACCOUNTING_ALLOW_LIVE_EXPORTS=false
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=

# Server-only OpenAI/AI configuration. Never expose these with NEXT_PUBLIC_.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_MODE=development
AI_LIVE_PROVIDER_ENABLED=false
AI_MAX_DAILY_REQUESTS=100
AI_MAX_TOKENS_PER_REQUEST=1200

# Server-only marketing attribution and future ad import configuration.
MARKETING_INTEGRATIONS_MODE=development
CAMPAIGNS_ALLOW_LIVE_SENDS=false
PUSH_ALLOW_LIVE_SENDS=false
LEAD_CAPTURE_API_TOKEN=replace-with-a-random-server-only-token
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Server-only GoHighLevel / LeadConnector read-only mirror configuration.
GHL_INTEGRATION_MODE=development
GHL_READ_SYNC_ENABLED=false
GHL_ALLOW_WRITES=false
GHL_SYNC_APPOINTMENT_EVERY_MINUTES=2
GHL_SYNC_OPPORTUNITY_EVERY_MINUTES=5
GHL_SYNC_CONTACT_EVERY_MINUTES=5
GHL_SYNC_CONVERSATION_EVERY_MINUTES=5
GHL_SYNC_MESSAGE_EVERY_MINUTES=5
GHL_SYNC_TRANSACTION_EVERY_MINUTES=15
GHL_SYNC_ORDER_EVERY_MINUTES=15
GHL_SYNC_CALENDAR_EVERY_MINUTES=30
GHL_SYNC_USER_EVERY_MINUTES=30
GHL_SYNC_CUSTOM_FIELD_EVERY_MINUTES=30
GHL_SYNC_TAG_EVERY_MINUTES=30
GHL_SYNC_PIPELINE_EVERY_MINUTES=30
GHL_DRIFT_RECONCILIATION_EVERY_MINUTES=360
GHL_SYNC_APPOINTMENT_LOOKBACK_MINUTES=20160
GHL_SYNC_APPOINTMENT_LOOKAHEAD_MINUTES=532800
GHL_INCREMENTAL_MAX_PAGES_PER_OBJECT=5
GHL_MIAMI_PRIVATE_TOKEN=
GHL_TAMPA_PRIVATE_TOKEN=
GHL_JACKSONVILLE_PRIVATE_TOKEN=
GHL_WEBHOOK_PUBLIC_KEY=
GHL_WEBHOOK_LEGACY_PUBLIC_KEY=
GHL_WEBHOOK_SECRET=
GHL_OAUTH_CLIENT_ID=
GHL_OAUTH_CLIENT_SECRET=
GHL_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/gohighlevel/oauth/callback
GHL_OAUTH_ENCRYPTION_KEY=
